{
  "name": "@meow-speech-v2/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone React client for Meow Speech V2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && vite build --mode capacitor",
    "cap:sync": "npm run build:capacitor && cap sync",
    "cap:sync:ios": "npm run build:capacitor && cap sync ios",
    "cap:sync:android": "npm run build:capacitor && cap sync android",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "test": "vitest run",
    "lint": "echo 'No linting configured yet'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
